    "test": "node --test dist"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vite": "^8.3.6"
  },
  "dependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
