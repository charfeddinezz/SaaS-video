{
  "name": "reel-forge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Autonomous short-video factory: script -> image/video/voice -> edit -> publish, driven by free daily-credit web UIs.",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
